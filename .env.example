# Gmail connection for the Corporate Travel Desk (read-only scope: gmail.readonly).
# Leave these empty and the desk shows "Gmail is not configured" plus the demo mailbox.

# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI must be exactly: <APP_BASE_URL>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of this app, no trailing slash. Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# 32+ random characters. Encrypts the Gmail session cookie. Generate: openssl rand -base64 48
GMAIL_SESSION_SECRET=
