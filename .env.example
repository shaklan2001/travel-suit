# Gmail connection for the Corporate Travel Desk (read-only scope: gmail.readonly).
# Leave these empty and the desk shows "Gmail is not configured" plus the demo mailbox.

# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI must be exactly: <APP_BASE_URL>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of this app, no trailing slash. Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# 32+ random characters. Encrypts the Gmail session cookie. Generate: openssl rand -base64 48
GMAIL_SESSION_SECRET=

# Vibrium worker fleet for the Corporate Travel Desk (server only, never exposed to the browser).
# With all of these set, every travel mail is read by the nine live workers. Leave them empty and
# the desk falls back to its scripted triage. The worker specs live in thomas-cook-travel-planner/.
VIBRIUM_API_BASE_URL=https://api-staging.vibrium.ai
VIBRIUM_CUSTOMER_ID=
VIBRIUM_SERVICE_USERNAME=
VIBRIUM_SERVICE_PASSWORD=
VIBRIUM_AGENT_EMAIL_CLASSIFIER=
VIBRIUM_AGENT_EMAIL_EXTRACTOR=
VIBRIUM_AGENT_CASE_LINKER=
VIBRIUM_AGENT_POLICY_GUARD=
VIBRIUM_AGENT_FLIGHT_OPTIONS=
VIBRIUM_AGENT_FARE_REVALIDATOR=
VIBRIUM_AGENT_BOOKING_PAYLOAD=
VIBRIUM_AGENT_REPLY_COMPOSER=
VIBRIUM_AGENT_ORCHESTRATOR=

# Trip Document Designer worker for the Trip Planner's documents studio (optional).
# With it set, the worker writes the document copy; without it the studio composes the copy itself.
VIBRIUM_AGENT_TRIP_DOCUMENT=
